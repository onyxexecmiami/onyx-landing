---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import YearReveal from '../components/YearReveal.astro';
import SiteScripts from '../components/SiteScripts.astro';
---
<Base lang="en" page="faq.html">
<Fragment slot="head">
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>FAQ — Onyx Executive Miami | Private Chauffeur Service South Florida</title>
<meta name="description" content="Answers about Onyx Executive Miami: service area, booking, payment, child seats, languages, and corporate accounts for private chauffeur service in South Florida." />
<meta name="theme-color" content="#0A0A0A" />
<Fonts />
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Which areas do you serve?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Miami-Dade, Broward, and Palm Beach \u2014 including Aventura, Sunny Isles, Bal Harbour, Brickell, Miami Beach, and Fort Lauderdale. Long-distance routes to the Keys, Naples, and Orlando on request."
      }
    },
    {
      "@type": "Question",
      "name": "How do I book?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Call or message on WhatsApp for the fastest response, or use the request form on the contact page. You deal with one point of contact from quote to drop-off."
      }
    },
    {
      "@type": "Question",
      "name": "How does pricing and payment work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Trips are quoted at a fixed price, confirmed before the ride, with tolls and standard wait time included. We accept card (via card reader), Zelle, and invoiced billing for corporate accounts."
      }
    },
    {
      "@type": "Question",
      "name": "Do you track flights?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. For airport and FBO pickups, your arrival is tracked and the pickup time adjusts to the actual landing, including delays and long customs."
      }
    },
    {
      "@type": "Question",
      "name": "Can you accommodate children and car seats?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Tell us the number and ages of children when you book so the correct seating is arranged in advance."
      }
    },
    {
      "@type": "Question",
      "name": "What languages do you speak?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "English, Russian, Ukrainian, and Polish."
      }
    },
    {
      "@type": "Question",
      "name": "Do you provide a certificate of insurance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A certificate of insurance is available on request, which is often needed by corporate offices and venues before a booking clears."
      }
    },
    {
      "@type": "Question",
      "name": "How far in advance should I book?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As early as possible for airport, FBO, and event work, especially on high-demand weekends. Shorter notice is often possible \u2014 call and we'll tell you straight away."
      }
    }
  ],
  "publisher": {
    "@id": "https://onyxexecmiami.com/#business"
  }
}
</script>
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://onyxexecmiami.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "FAQ"
    }
  ]
}
</script>
</Fragment>
<SiteHeader page="faq.html" />

<section class="page-hero">
<div class="wrap">
<p class="breadcrumb"><a href="/">Home</a> / FAQ</p>
<p class="eyebrow on-dark">FAQ</p>
<h1 class="display">Good to know.</h1>
<div class="rule"></div>
<p class="lead">The questions clients ask most. Anything else — call or message and we'll answer directly.</p>
</div>
</section>
<section class="section-soft">
<div class="wrap faq reveal">
<details><summary>Which areas do you serve?<span class="pm">+</span></summary><div class="ans">Miami-Dade, Broward, and Palm Beach — including Aventura, Sunny Isles, Bal Harbour, Brickell, Miami Beach, and Fort Lauderdale. Long-distance routes to the Keys, Naples, and Orlando on request.</div></details>
<details><summary>How do I book?<span class="pm">+</span></summary><div class="ans">Call or message on WhatsApp for the fastest response, or use the request form on the contact page. You deal with one point of contact from quote to drop-off.</div></details>
<details><summary>How does pricing and payment work?<span class="pm">+</span></summary><div class="ans">Trips are quoted at a fixed price, confirmed before the ride, with tolls and standard wait time included. We accept card (via card reader), Zelle, and invoiced billing for corporate accounts.</div></details>
<details><summary>Do you track flights?<span class="pm">+</span></summary><div class="ans">Yes. For airport and FBO pickups, your arrival is tracked and the pickup time adjusts to the actual landing, including delays and long customs.</div></details>
<details><summary>Can you accommodate children and car seats?<span class="pm">+</span></summary><div class="ans">Yes. Tell us the number and ages of children when you book so the correct seating is arranged in advance.</div></details>
<details><summary>What languages do you speak?<span class="pm">+</span></summary><div class="ans">English, Russian, Ukrainian, and Polish.</div></details>
<details><summary>Do you provide a certificate of insurance?<span class="pm">+</span></summary><div class="ans">A certificate of insurance is available on request, which is often needed by corporate offices and venues before a booking clears.</div></details>
<details><summary>How far in advance should I book?<span class="pm">+</span></summary><div class="ans">As early as possible for airport, FBO, and event work, especially on high-demand weekends. Shorter notice is often possible — call and we'll tell you straight away.</div></details>
</div>
</section>
<section class="cta-band"><div class="wrap">
<h2 class="h2">Still have a question?</h2>
<p>Call or message — you'll get a direct answer, not a ticket.</p>
<div class="actions"><a class="btn btn-light" href="tel:+17869316699">Call +1 786 931 ONYX (6699)</a><a class="btn btn-ghost" href="contact.html#book">Contact</a></div>
</div></section>
<SiteFooter />
<div class="mbar"><a href="tel:+17869316699">Call</a><a href="https://wa.me/17869316699?text=Hi%2C%20I%27d%20like%20a%20quote." target="_blank" rel="noopener">WhatsApp</a></div>
<YearReveal />
<SiteScripts />
</Base>
