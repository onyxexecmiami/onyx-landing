<tr style="border-bottom:1px solid #ddd"><td style="padding:10px 12px">Terminal de cruceros de PortMiami</td><td style="padding:10px 12px">MIA</td><td style="padding:10px 12px">7,1 mi · 15–25 min</td><td style="padding:10px 12px">FLL</td><td style="padding:10px 12px">Deje un margen por el tráfico del día de cruceros.</td></tr>
<tr><td style="padding:10px 12px">Port Everglades</td><td style="padding:10px 12px">FLL</td><td style="padding:10px 12px">1,8 mi · 10–15 min</td><td style="padding:10px 12px">MIA</td><td style="padding:10px 12px">Junto al corredor de cruceros de Fort Lauderdale.</td></tr>
