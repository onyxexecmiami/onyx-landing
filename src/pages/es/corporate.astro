import SiteScripts from '../../components/SiteScripts.astro';
---
<Base lang="es" page="corporate.html">
<Fragment slot="head">
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Transporte corporativo en Miami | Onyx Executive Miami</title>
<meta name="description" content="Transporte terrestre corporativo en Miami y el sur de la Florida, con una sola cuenta, facturación consolidada y una línea directa para asistentes ejecutivos y equipos de viajes." />
<meta name="theme-color" content="#0A0A0A" />
<Fonts />
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Servicio de transporte corporativo",
  "provider": {
    "@id": "https://onyxexecmiami.com/#business",
    "name": "Onyx Executive Miami",
    "url": "https://onyxexecmiami.com/es/"
  },
  "areaServed": {
    "@type": "State",
    "name": "Sur de la Florida"
  },
  "url": "https://onyxexecmiami.com/es/corporate.html"
}
</script>
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": "https://onyxexecmiami.com/es/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Corporativo"
    }
  ]
}
</script>
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Quién puede reservar con una cuenta corporativa?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Cualquier persona autorizada que usted designe, como un asistente ejecutivo, un administrador de oficina o un coordinador de viajes, puede reservar y confirmar traslados directamente, sin tener que canalizar cada solicitud a través del viajero."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cómo funciona la facturación?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Un estado de cuenta consolidado para la cuenta, con los viajes etiquetados por departamento o proyecto a solicitud, para el control interno de centros de costo."
      }
    },
    {
      "@type": "Question",
      "name": "¿Pueden proporcionar un COI o un W-9 antes de reservar?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí. Ambos se entregan a solicitud, normalmente antes de que se procese la primera reserva si su oficina o el lugar lo exige como parte del registro de proveedores."
      }
    },
    {
      "@type": "Question",
      "name": "¿Ofrecen condiciones NET?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Las condiciones de facturación se establecen de forma individual para cada cuenta al abrirla; pregúntenos al contactarnos y le confirmaremos la opción que mejor se adapte."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué sucede si los planes de un viajero cambian a último momento?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Los cambios se comunican a la misma línea directa que confirmó la reserva, no a una cola de espera, y se actualizan en el viaje en tiempo real."
      }
    }
  ]
}
</script>
</Fragment>
<SiteHeader lang="es" page="corporate.html" current="corporate.html" />

