<meta name="theme-color" content="#0A0A0A" />
<Fonts />
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Servicio de transporte escolar",
  "provider": {
    "@id": "https://onyxexecmiami.com/#business",
    "name": "Onyx Executive Miami",
    "url": "https://onyxexecmiami.com/es/"
  },
  "areaServed": {
    "@type": "State",
    "name": "Sur de Florida"
  },
  "url": "https://onyxexecmiami.com/es/school-transportation.html"
}
</script>
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": "https://onyxexecmiami.com/es/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Transporte escolar"
    }
  ]
}
</script>
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Qué pasa si el chófer principal no está disponible un día?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Un chófer suplente aprobado, conocido por la familia con antelación, cubre la ruta; nunca un sustituto que aparece sin previo aviso."
      }
    },
    {
      "@type": "Question",
      "name": "¿Quién está autorizado a cambiar los horarios o los detalles de recogida?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Solo los padres, tutores o contactos de la oficina familiar indicados al establecer la ruta. Los cambios solicitados por cualquier otra persona se confirman con un contacto autorizado antes de realizarse."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué información necesitan sobre el niño?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Edad, estatura y peso, para preparar la silla o el elevador adecuados, además de un contacto de emergencia registrado, distinto de los contactos autorizados del día a día."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cómo se confirma la entrega?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El chófer confirma la llegada a la escuela y que la entrega se completó; el niño no se deja en un punto de descenso sin confirmación."
      }
    },
    {
      "@type": "Question",
      "name": "¿Puedo contratarlo por semana, por mes o por el período escolar?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí. Las rutas suelen acordarse por semana, por mes o por el período escolar completo, según el horario de la familia."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuál es la política de cancelación para un solo día?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Avise a su contacto autorizado lo antes posible; las rutas fijas se mantienen según el horario acordado y los cambios de un solo día se gestionan directamente, no mediante un formulario general de cancelación."
      }
    },
    {
      "@type": "Question",
      "name": "¿Nuestra información se mantiene privada?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí. Los detalles de la ruta, los horarios y cualquier información sobre los niños se comparten únicamente con el chófer asignado y no se comentan fuera del acuerdo."
      }
    }
  ]
}
</script>
</Fragment>
