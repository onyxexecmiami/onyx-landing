<SiteFooter lang="es" />
<div class="mbar"><a href="tel:+17869316699">Llamar</a><a href="https://wa.me/17869316699?text=Hola%2C%20quisiera%20una%20cotizaci%C3%B3n." target="_blank" rel="noopener">WhatsApp</a></div>
<YearReveal />
<SiteScripts />
</Base>
