import YearReveal from '../../components/YearReveal.astro';
import SiteScripts from '../../components/SiteScripts.astro';
---
<Base lang="es" page="blog.html">
<Fragment slot="head">
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Blog — Guías de viaje para el sur de Florida | Onyx Executive Miami</title>
<meta name="description" content="Guías prácticas sobre traslados al aeropuerto, aviación privada y viajes ejecutivos en Miami, Fort Lauderdale y Palm Beach, de Onyx Executive Miami." />
<meta name="theme-color" content="#0A0A0A" />
<Fonts />
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Guía ejecutiva del sur de Florida",
  "url": "https://onyxexecmiami.com/es/blog.html",
  "publisher": {
    "@id": "https://onyxexecmiami.com/#business"
  }
}
</script>
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
