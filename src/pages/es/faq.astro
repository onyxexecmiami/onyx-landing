---
import Base from '../../layouts/Base.astro';
import Fonts from '../../components/Fonts.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import YearReveal from '../../components/YearReveal.astro';
import SiteScripts from '../../components/SiteScripts.astro';
---
<Base lang="es" page="faq.html">
<Fragment slot="head">
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Preguntas frecuentes — Onyx Executive Miami | Servicio de chófer privado en el sur de Florida</title>
<meta name="description" content="Respuestas sobre Onyx Executive Miami: zona de servicio, reservas, pagos, sillas para niños, idiomas y cuentas corporativas del servicio de chófer privado en el sur de Florida." />
<meta name="theme-color" content="#0A0A0A" />
<Fonts />
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Qué zonas atienden?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Miami-Dade, Broward y Palm Beach, incluidas Aventura, Sunny Isles, Bal Harbour, Brickell, Miami Beach y Fort Lauderdale. Rutas de larga distancia a los Cayos, Naples y Orlando bajo solicitud."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cómo reservo?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Llame o escriba por WhatsApp para obtener la respuesta más rápida, o use el formulario de solicitud de la página de contacto. Usted trata con un solo punto de contacto, desde la cotización hasta el destino."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cómo funcionan las tarifas y el pago?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Los viajes se cotizan a un precio fijo, confirmado antes del servicio, con peajes y tiempo de espera estándar incluidos. Aceptamos tarjeta (mediante lector), Zelle y facturación para cuentas corporativas."
      }
    },
    {
      "@type": "Question",
      "name": "¿Realizan seguimiento de vuelo?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí. En los recogidos en aeropuertos y FBO, se sigue su llegada y la hora de recogida se ajusta al aterrizaje real, incluidos los retrasos y las demoras prolongadas en aduana."
      }
    },
    {
      "@type": "Question",
      "name": "¿Pueden atender a niños y contar con sillas para niños?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí. Indíquenos el número y la edad de los niños al reservar para que el asiento adecuado esté preparado con antelación."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué idiomas hablan?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Inglés, ruso, ucraniano y polaco."
      }
    },
    {
      "@type": "Question",
      "name": "¿Proporcionan un certificado de seguro?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Se puede proporcionar un certificado de seguro bajo solicitud; las oficinas corporativas y los recintos suelen requerirlo antes de confirmar una reserva."
      }
    },
    {
      "@type": "Question",
      "name": "¿Con cuánta anticipación debo reservar?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Lo antes posible para servicios de aeropuerto, FBO y eventos, especialmente en los fines de semana de mayor demanda. A menudo es posible con menos antelación: llame y le diremos de inmediato."
      }
    }
  ],
  "publisher": {
    "@id": "https://onyxexecmiami.com/#business"
  }
}
</script>
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": "https://onyxexecmiami.com/es/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Preguntas frecuentes"
    }
  ]
}
</script>
</Fragment>
<SiteHeader lang="es" page="faq.html" />

