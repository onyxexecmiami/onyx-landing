<title>Corporate Transportation Miami | Onyx Executive Miami</title>
<meta name="description" content="Corporate ground transportation in Miami and South Florida, with one account, consolidated billing, and a direct line for executive assistants and travel teams." />
<meta name="theme-color" content="#0A0A0A" />
<Fonts />
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Corporate transportation service",
  "provider": {
    "@id": "https://onyxexecmiami.com/#business",
    "name": "Onyx Executive Miami",
    "url": "https://onyxexecmiami.com/"
  },
  "areaServed": {
    "@type": "State",
    "name": "South Florida"
  },
  "url": "https://onyxexecmiami.com/corporate.html"
}
</script>
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://onyxexecmiami.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Corporate"
    }
  ]
}
</script>
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {"@type": "Question","name": "Who can book on a corporate account?","acceptedAnswer": {"@type": "Answer","text": "Any authorized booker you name — an executive assistant, office manager, or travel coordinator — can book and confirm rides directly, without routing every request through the traveler."}},
    {"@type": "Question","name": "How does billing work?","acceptedAnswer": {"@type": "Answer","text": "One consolidated statement for the account, with trips tagged by department or project on request for internal cost-center tracking."}},
    {"@type": "Question","name": "Can you provide a COI or W-9 before we book?","acceptedAnswer": {"@type": "Answer","text": "Yes — both are provided on request, typically before the first booking clears if your office or venue requires it as part of vendor setup."}},
    {"@type": "Question","name": "Do you offer NET terms?","acceptedAnswer": {"@type": "Answer","text": "Billing terms are set up individually per account when it's opened — ask when you reach out and we'll confirm what fits."}},
    {"@type": "Question","name": "What happens if a traveler's plans change last minute?","acceptedAnswer": {"@type": "Answer","text": "Changes go to the same direct line that confirmed the booking — not a queue — and are updated on the ride in real time."}}
  ]
}
</script>
