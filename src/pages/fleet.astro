---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import YearReveal from '../components/YearReveal.astro';
import SiteScripts from '../components/SiteScripts.astro';
---
<Base lang="en" page="fleet.html">
<Fragment slot="head">
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Our Vehicle — 2026 Chevrolet Suburban RST | Onyx Executive Miami</title>
<meta name="description" content="A single, immaculately maintained 2026 Chevrolet Suburban RST — the vehicle behind every Onyx Executive Miami trip. Seating, amenities, and what to expect on board." />
<meta name="theme-color" content="#0A0A0A" />
<Fonts />
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Vehicle",
  "name": "2026 Chevrolet Suburban RST",
  "vehicleModelDate": "2026",
  "manufacturer": {
    "@type": "Organization",
    "name": "Chevrolet"
  },
  "model": "Suburban RST",
  "image": "https://onyxexecmiami.com/suburban-front.webp",
  "offers": {
    "@type": "Offer",
    "offeredBy": {
      "@id": "https://onyxexecmiami.com/#business"
    }
  }
}
</script>
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://onyxexecmiami.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Our Vehicle"
    }
  ]
}
</script>
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {"@type": "Question","name": "Why only one vehicle instead of a larger fleet?","acceptedAnswer": {"@type": "Answer","text": "One vehicle, maintained to a single standard, means you know exactly what's arriving before it does. As Onyx grows to a small network, every added vehicle is held to the same standard rather than rotated through a rental pool."}},
    {"@type": "Question","name": "Is the vehicle cleaned between every trip?","acceptedAnswer": {"@type": "Answer","text": "Yes. Interior and exterior are checked and cleaned between trips, not on a fixed schedule that could leave it presentable-but-not-immaculate for a same-day back-to-back booking."}},
    {"@type": "Question","name": "Can the Suburban fit golf clubs, strollers, or oversized luggage?","acceptedAnswer": {"@type": "Answer","text": "Usually, yes \u2014 capacity depends on passenger count alongside bag count and size. Tell us what you're bringing at booking and we'll confirm it fits before you arrive, not after."}},
    {"@type": "Question","name": "What happens if the vehicle needs unexpected maintenance?","acceptedAnswer": {"@type": "Answer","text": "Maintenance is scheduled around bookings, not the other way around, and the network of vetted partner vehicles covers the rare case of an unplanned issue so a booking is never simply cancelled."}},
    {"@type": "Question","name": "Are child seats included, or do I need to bring my own?","acceptedAnswer": {"@type": "Answer","text": "Child seats are arranged in advance once you tell us ages at booking \u2014 you don't need to bring your own unless you specifically prefer to."}}
  ]
}
</script>
</Fragment>
<SiteHeader page="fleet.html" current="fleet.html" />

<section class="page-hero">
<div class="wrap">
<p class="breadcrumb"><a href="/">Home</a> / Our Vehicle</p>
<p class="eyebrow on-dark">The Fleet</p>
<h1 class="display">One vehicle. Immaculately kept.</h1>
<div class="rule"></div>
<p class="lead">A 2026 Chevrolet Suburban RST — the same vehicle behind every Onyx trip, maintained to a single standard rather than rotated through a rental pool.</p>
<div class="page-actions">
<a class="btn btn-light" href="tel:+17869316699">Call now</a>
<a class="btn btn-ghost" href="contact.html#book">Request a quote</a>
</div>
<p class="trust-line">+1 786 931 ONYX (6699) · Licensed &amp; insured · Miami-Dade Permit #64666 · D-U-N-S&reg; 13-860-0693</p>
</div>
</section>
<section class="section-soft" style="padding-top:0">
<div class="wrap"><div class="feat-img reveal" style="aspect-ratio:16/9"><picture><source type="image/avif" srcset="suburban-front.avif" /><img src="suburban-front.webp" alt="2026 Chevrolet Suburban RST, black, front three-quarter view at a South Florida resort" width="1100" height="1467" decoding="async" fetchpriority="high" /></picture></div></div>
</section>
<section class="section-soft">
<div class="wrap">
<div class="grid-head reveal" style="text-align:center;margin-bottom:28px">
<p class="eyebrow">Fleet Standards</p>
<h2 class="h2">Every Trip, Same Standard</h2>
<div class="rule"></div>
<p class="lead">Built to a consistent standard. Inspected every trip.</p>
</div>
<div class="cards reveal" style="text-align:center">
<div class="card" style="cursor:default"><h3>Pre-Trip Inspection</h3><p>Checked before every trip — interior, exterior, fluids, tires. No exceptions.</p></div>
<div class="card" style="cursor:default"><h3>Complimentary Amenities</h3><p>Cold bottled water and phone chargers for every seat. Climate control set before you get in.</p></div>
<div class="card" style="cursor:default"><h3>Fully Insured</h3><p>Commercial insurance, a licensed chauffeur, and full compliance with Miami-Dade requirements.</p></div>
</div>
</div>
</section>
<section class="section-soft">
<div class="wrap split">
<div class="prose reveal">
<h2 class="h2">Space, without compromise</h2>
<div class="rule"></div>
<p>Seating for up to six passengers. Luggage capacity depends on passenger count, suitcase dimensions, child seats, strollers, golf bags, and whether every seating row is required. Capacity is confirmed before booking.</p>
<div class="feat-img reveal" style="aspect-ratio:4/3;margin-top:24px"><picture><source type="image/avif" srcset="interior-seats.avif" /><img src="interior-seats.webp" alt="Interior seating of the Onyx Executive Miami Chevrolet Suburban RST" width="700" height="933" decoding="async" loading="lazy" /></picture></div>
</div>
<div class="prose reveal">
<h2 class="h2">On board</h2>
<div class="rule"></div>
<ul class="points">
<li><i class="mark"></i><span><b>Climate control</b> front and rear, set before you get in.</span></li>
<li><i class="mark"></i><span><b>Bottled water</b> and phone chargers for every seat.</span></li>
<li><i class="mark"></i><span><b>Quiet cabin</b> — no radio or conversation unless you want it.</span></li>
<li><i class="mark"></i><span><b>Child seats</b> arranged in advance when you tell us ages at booking.</span></li>
</ul>
<div class="feat-img reveal" style="aspect-ratio:4/3;margin-top:24px"><picture><source type="image/avif" srcset="interior-amenities.avif" /><img src="interior-amenities.webp" alt="Interior amenities in the Onyx Executive Miami Chevrolet Suburban RST" width="700" height="933" decoding="async" loading="lazy" /></picture></div>
</div>
</div>
</section>
<section class="section-dark">
<div class="wrap split center">
<div class="prose reveal">
<p class="eyebrow on-dark">Why one vehicle</p>
<h2 class="h2">Consistency over a fleet.</h2>
<div class="rule"></div>
<p>A single, well-maintained vehicle means no surprises — you know exactly what's arriving before it does. It's also the point of the Onyx Standard: founder-level accountability for the vehicle, not just the driver.</p>
<div style="margin-top:28px"><a class="btn btn-outline" href="the-onyx-standard.html">Read the Onyx Standard</a></div>
</div>
<div class="feat-img reveal"><picture><source type="image/avif" srcset="suburban-side.avif" /><img src="suburban-side.webp" alt="Onyx Executive Miami Chevrolet Suburban RST, side profile" width="1100" height="825" decoding="async" loading="lazy" /></picture></div>
</div>
</section>
<section class="section-dark">
<div class="wrap">
<div class="grid-head reveal">
<h2 class="h2">Questions about the vehicle</h2>
<div class="rule"></div>
</div>
<div class="faq reveal">
<details><summary>Why only one vehicle instead of a larger fleet?<span class="pm">+</span></summary><div class="ans">One vehicle, maintained to a single standard, means you know exactly what's arriving before it does. As Onyx grows to a small network, every added vehicle is held to the same standard rather than rotated through a rental pool.</div></details>
<details><summary>Is the vehicle cleaned between every trip?<span class="pm">+</span></summary><div class="ans">Yes. Interior and exterior are checked and cleaned between trips, not on a fixed schedule that could leave it presentable-but-not-immaculate for a same-day back-to-back booking.</div></details>
<details><summary>Can the Suburban fit golf clubs, strollers, or oversized luggage?<span class="pm">+</span></summary><div class="ans">Usually, yes — capacity depends on passenger count alongside bag count and size. Tell us what you're bringing at booking and we'll confirm it fits before you arrive, not after.</div></details>
<details><summary>What happens if the vehicle needs unexpected maintenance?<span class="pm">+</span></summary><div class="ans">Maintenance is scheduled around bookings, not the other way around, and the network of vetted partner vehicles covers the rare case of an unplanned issue so a booking is never simply cancelled.</div></details>
<details><summary>Are child seats included, or do I need to bring my own?<span class="pm">+</span></summary><div class="ans">Child seats are arranged in advance once you tell us ages at booking — you don't need to bring your own unless you specifically prefer to.</div></details>
</div>
</div>
</section>
<section class="section-soft">
<div class="wrap">
<div class="grid-head reveal"><h2 class="h2">Related</h2><div class="rule"></div></div>
<div class="related reveal">
<a href="the-onyx-standard.html"><span class="rk">Company</span><h3>The Onyx Standard</h3></a>
<a href="airport-transfers.html"><span class="rk">Service</span><h3>Airport Transfers</h3></a>
<a href="corporate.html"><span class="rk">Service</span><h3>Corporate Transportation</h3></a>
<a href="school-transportation.html"><span class="rk">Service</span><h3>School Transportation</h3></a>
<a href="service-area.html"><span class="rk">Company</span><h3>Service Area</h3></a>
<a href="event-transportation.html"><span class="rk">Service</span><h3>Event Transportation</h3></a>
</div>
</div>
</section>
<section class="cta-band"><div class="wrap">
<h2 class="h2">See it for your next trip.</h2>
<p>Call or message for a fixed quote — one accountable standard, whoever's behind the wheel.</p>
<div class="actions"><a class="btn btn-light" href="tel:+17869316699">Call +1 786 931 ONYX (6699)</a><a class="btn btn-ghost" href="contact.html#book">Request a quote</a></div>
</div></section>
<SiteFooter />
<div class="mbar"><a href="tel:+17869316699">Call</a><a href="https://wa.me/17869316699?text=Hi%2C%20I%27d%20like%20a%20quote." target="_blank" rel="noopener">WhatsApp</a></div>
<YearReveal />
<SiteScripts />
</Base>
