---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteScripts from '../components/SiteScripts.astro';
---
<Base lang="en">
<Fragment slot="head">
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Contact &amp; Booking — Onyx Executive Miami | +1 786 931 ONYX (6699)</title>
<meta name="description" content="Book Onyx Executive Miami: call +1 786 931 ONYX (6699), message on WhatsApp, or send the request form. Private chauffeur service across Miami, Fort Lauderdale, and Palm Beach." />
<link rel="canonical" href="https://onyxexecmiami.com/contact.html" />
<meta name="theme-color" content="#0A0A0A" />
<Fonts />
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "url": "https://onyxexecmiami.com/contact.html",
  "about": {
    "@id": "https://onyxexecmiami.com/#business"
  }
}
</script>
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://onyxexecmiami.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Contact"
    }
  ]
}
</script>
</Fragment>
<SiteHeader current="contact.html" mobileCurrent="contact.html" />

<section class="page-hero">
<div class="wrap">
<p class="breadcrumb"><a href="/">Home</a> / Contact</p>
<p class="eyebrow on-dark">Contact &amp; Booking</p>
<h1 class="display">Tell us where you need to be.</h1>
<div class="rule"></div>
<p class="lead">Call for a fast answer, message on WhatsApp, or send the details below.</p>
</div>
</section>
<section class="section-soft" style="padding-bottom:0">
<div class="wrap">
<div class="cards reveal" style="margin-bottom:0">
<a class="card" href="#book"><div class="no">01</div><h3>Request a Ride</h3><p>Airport, hourly, or one-off transportation.</p><div class="more">Use the form below ↓</div></a>
<a class="card" href="corporate.html#account"><div class="no">02</div><h3>Corporate Account</h3><p>Recurring business travel, consolidated billing.</p><div class="more">Open an account →</div></a>
<a class="card" href="school-transportation.html"><div class="no">03</div><h3>Family &amp; Recurring Transportation</h3><p>Consistent chauffeur for ongoing family travel.</p><div class="more">Learn more →</div></a>
</div>
</div>
</section>
<section id="book" class="section-dark">
<div class="wrap book">
<div class="reveal">
<p class="eyebrow on-dark">Direct</p>
<h2 class="h2">One contact. Fast reply.</h2>
<div class="rule"></div>
<p class="lead">You reach the person accountable for your transportation — not a queue.</p>
<div class="contact-list">
<a href="tel:+17869316699"><span><span class="clab">Phone</span>+1 786 931 ONYX (6699)</span></a><a href="mailto:info@onyxexecmiami.com"><span><span class="clab">Email</span>info@onyxexecmiami.com</span></a>
<a href="https://wa.me/17869316699?text=Hi%2C%20I%27d%20like%20to%20arrange%20a%20chauffeur%20in%20South%20Florida." target="_blank" rel="noopener"><span><span class="clab">WhatsApp</span>Message us</span></a>
<a href="https://instagram.com/onyxexecmiami" target="_blank" rel="noopener"><span><span class="clab">Instagram</span>@onyxexecmiami</span></a>
</div>
</div>
<div class="reveal">
<div class="form-grid">
<div class="field"><label for="f-name">Name</label><input id="f-name" type="text" placeholder="Your name" /></div>
<div class="field"><label for="f-phone">Phone / WhatsApp</label><input id="f-phone" type="tel" placeholder="+1 …" /></div>
<div class="field"><label for="f-email">Email</label><input id="f-email" type="email" placeholder="you@example.com" /></div>
<div class="field"><label for="f-date">Date &amp; time</label><input id="f-date" type="text" placeholder="e.g. Jun 20, 3:00 PM" /></div>
<div class="field full"><label for="f-from">Pickup address</label><input id="f-from" type="text" placeholder="Address, airport, or FBO" /></div>
<div class="field full"><label for="f-to">Destination</label><input id="f-to" type="text" placeholder="Address, airport, or FBO" /></div>
<div class="field"><label for="f-pax">Passengers</label><input id="f-pax" type="number" min="1" placeholder="2" /></div>
<div class="field"><label for="f-luggage">Luggage</label><input id="f-luggage" type="number" min="0" placeholder="2" /></div>
<div class="field"><label for="f-flight">Flight number</label><input id="f-flight" type="text" placeholder="If applicable" /></div>
<div class="field"><label for="f-for">Booking for</label>
<select id="f-for"><option>Myself</option><option>Another passenger</option></select>
</div>
<div class="field"><label for="f-seat">Child seat / booster</label>
<select id="f-seat"><option>Not needed</option><option>Infant seat</option><option>Convertible seat</option><option>Booster</option></select>
</div>
<div class="field"><label for="f-contact-pref">Preferred response</label>
<select id="f-contact-pref"><option>Call</option><option>WhatsApp</option><option>Email</option></select>
</div>
<div class="field full"><label for="f-svc">Service</label>
<select id="f-svc"><option>Airport transfer</option><option>Private aviation / FBO</option><option>Corporate</option><option>Hourly / as-directed</option><option>School / family</option><option>Event</option><option>Long-distance</option></select>
</div>
<div class="field full"><label for="f-notes">Additional information</label><input id="f-notes" type="text" placeholder="Anything else we should know" /></div>
</div>
<div class="form-actions">
<button class="btn btn-light" id="sendBtn" type="button">Send via WhatsApp</button>
<a class="btn btn-ghost" href="tel:+17869316699">Or call instead</a>
</div>
<p class="form-note">Opens WhatsApp with your details prefilled. Nothing is sent until you press send there. Every request is reviewed and confirmed individually before a vehicle is assigned.</p>
<p class="form-note" style="margin-top:8px;opacity:.7">Submitting this form sends your details to Onyx Executive Miami via WhatsApp or email, used only to arrange and confirm your ride. No information is sold or shared with third parties.</p>
</div>
</div>
</section>
<SiteFooter current="contact.html" />
<div class="mbar"><a href="tel:+17869316699">Call</a><a href="https://wa.me/17869316699?text=Hi%2C%20I%27d%20like%20to%20arrange%20a%20chauffeur%20in%20South%20Florida." target="_blank" rel="noopener">WhatsApp</a></div>
<script is:inline>
document.getElementById('yr').textContent=new Date().getFullYear();
var b=document.getElementById('sendBtn');
if(b){b.addEventListener('click',function(){
var v=function(id){var e=document.getElementById(id);return e?(e.value||'').trim():'';};
var t=['New chauffeur request — Onyx Executive Miami','','Name: '+(v('f-name')||'—'),'Phone: '+(v('f-phone')||'—'),'Email: '+(v('f-email')||'—'),'Service: '+v('f-svc'),'Date/time: '+(v('f-date')||'—'),'Passengers: '+(v('f-pax')||'—'),'Luggage: '+(v('f-luggage')||'—'),'Flight #: '+(v('f-flight')||'—'),'Booking for: '+v('f-for'),'Child seat: '+v('f-seat'),'Pickup: '+(v('f-from')||'—'),'Drop-off: '+(v('f-to')||'—'),'Preferred response: '+v('f-contact-pref'),'Notes: '+(v('f-notes')||'—')];
if(typeof gtag==='function'){gtag('event','generate_lead',{event_category:'contact',event_label:'contact_full_form',service:v('f-svc')});}
window.open('https://wa.me/17869316699?text='+encodeURIComponent(t.join('\n')),'_blank');
});}
var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});},{threshold:.12});
document.querySelectorAll('.reveal').forEach(function(el){io.observe(el);});
</script>
<SiteScripts />
</Base>
