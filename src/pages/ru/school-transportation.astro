<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Что, если основной шофёр не сможет выйти в какой-то день?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Маршрут берёт на себя согласованный резервный шофёр, которого семья знает заранее, — никаких неожиданных замен незнакомым человеком."
      }
    },
    {
      "@type": "Question",
      "name": "Кто вправе менять время подачи или другие детали?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Только родители, опекуны или представители семейного офиса, названные при организации маршрута. Изменения от кого-либо другого мы сначала подтверждаем с уполномоченным контактом."
      }
    },
    {
      "@type": "Question",
      "name": "Какие сведения о ребёнке вам нужны?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Возраст, рост и вес — чтобы подобрать подходящее детское кресло или бустер, а также экстренный контакт, который хранится отдельно от ежедневных уполномоченных контактов."
      }
    },
    {
      "@type": "Question",
      "name": "Как подтверждается высадка?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Шофёр подтверждает прибытие в школу и то, что ребёнка передали из рук в руки, — ребёнка не оставляют в месте высадки без подтверждения."
      }
    },
    {
      "@type": "Question",
      "name": "Можно ли оформить поездки на неделю, месяц или на весь учебный период?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Да — маршруты обычно организуются на неделю, месяц или весь учебный период, в зависимости от графика семьи."
      }
    },
    {
      "@type": "Question",
      "name": "Каковы условия отмены на один день?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Сообщите уполномоченному контакту как можно раньше; постоянные маршруты сохраняются за согласованным графиком, а изменения на один день решаются напрямую, без общей формы отмены."
      }
    },
    {
      "@type": "Question",
      "name": "Сохраняется ли конфиденциальность наших данных?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Да — детали маршрута, расписание и любые сведения о детях известны только назначенному шофёру и не обсуждаются за пределами договорённости."
      }
    }
  ]
}
</script>
