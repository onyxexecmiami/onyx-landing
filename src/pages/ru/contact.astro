---
import Base from '../../layouts/Base.astro';
import Fonts from '../../components/Fonts.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteScripts from '../../components/SiteScripts.astro';
---
<Base lang="ru" page="contact.html">
<Fragment slot="head">
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Контакты и бронирование — Onyx Executive Miami | +1 786 931 ONYX (6699)</title>
<meta name="description" content="Забронируйте Onyx Executive Miami: позвоните по +1 786 931 ONYX (6699), напишите в WhatsApp или отправьте форму. Частный шофёр в Майами, Форт-Лодердейле и Палм-Бич." />
<meta name="theme-color" content="#0A0A0A" />
<Fonts />
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "url": "https://onyxexecmiami.com/ru/contact.html",
  "about": {
    "@id": "https://onyxexecmiami.com/#business"
  }
}
</script>
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Главная",
      "item": "https://onyxexecmiami.com/ru/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Контакты"
    }
  ]
}
</script>
</Fragment>
<SiteHeader lang="ru" page="contact.html" current="contact.html" mobileCurrent="contact.html" />

<section class="page-hero">
<div class="wrap">
<p class="breadcrumb"><a href="/ru/">Главная</a> / Контакты</p>
<p class="eyebrow on-dark">Контакты и бронирование</p>
<h1 class="display">Расскажите, куда вам нужно попасть.</h1>
<div class="rule"></div>
<p class="lead">Позвоните, чтобы получить быстрый ответ, напишите в WhatsApp или отправьте данные ниже.</p>
</div>
</section>
<section class="section-soft" style="padding-bottom:0">
<div class="wrap">
<div class="cards reveal" style="margin-bottom:0">
<a class="card" href="#book"><div class="no">01</div><h3>Заказать поездку</h3><p>Трансфер из аэропорта, почасовая или разовая поездка.</p><div class="more">Воспользуйтесь формой ниже ↓</div></a>
<a class="card" href="corporate.html#account"><div class="no">02</div><h3>Корпоративный счёт</h3><p>Регулярные деловые поездки, единый счёт.</p><div class="more">Открыть счёт →</div></a>
<a class="card" href="school-transportation.html"><div class="no">03</div><h3>Семейные и регулярные поездки</h3><p>Постоянный шофёр для регулярных семейных поездок.</p><div class="more">Подробнее →</div></a>
</div>
</div>
</section>
<section id="book" class="section-dark">
<div class="wrap book">
<div class="reveal">
<p class="eyebrow on-dark">Напрямую</p>
<h2 class="h2">Один контакт. Быстрый ответ.</h2>
<div class="rule"></div>
<p class="lead">Вы связываетесь с человеком, который отвечает за вашу поездку, а не с очередью обращений.</p>
<div class="contact-list">
<a href="tel:+17869316699"><span><span class="clab">Телефон</span>+1 786 931 ONYX (6699)</span></a><a href="mailto:info@onyxexecmiami.com"><span><span class="clab">Эл. почта</span>info@onyxexecmiami.com</span></a>
<a href="https://wa.me/17869316699?text=%D0%97%D0%B4%D1%80%D0%B0%D0%B2%D1%81%D1%82%D0%B2%D1%83%D0%B9%D1%82%D0%B5%2C%20%D1%85%D0%BE%D1%82%D0%B5%D0%BB%20%D0%B1%D1%8B%20%D0%B7%D0%B0%D0%BA%D0%B0%D0%B7%D0%B0%D1%82%D1%8C%20%D1%88%D0%BE%D1%84%D1%91%D1%80%D0%B0%20%D0%B2%20%D0%AE%D0%B6%D0%BD%D0%BE%D0%B9%20%D0%A4%D0%BB%D0%BE%D1%80%D0%B8%D0%B4%D0%B5." target="_blank" rel="noopener"><span><span class="clab">WhatsApp</span>Написать нам</span></a>
<a href="https://instagram.com/onyxexecmiami" target="_blank" rel="noopener"><span><span class="clab">Instagram</span>@onyxexecmiami</span></a>
</div>
</div>
<div class="reveal">
<div class="form-grid">
<div class="field"><label for="f-name">Имя</label><input id="f-name" type="text" placeholder="Ваше имя" /></div>
<div class="field"><label for="f-phone">Телефон / WhatsApp</label><input id="f-phone" type="tel" placeholder="+1 …" /></div>
<div class="field"><label for="f-email">Эл. почта</label><input id="f-email" type="email" placeholder="you@example.com" /></div>
<div class="field"><label for="f-date">Дата и время</label><input id="f-date" type="text" placeholder="например, 20 июня, 15:00" /></div>
<div class="field full"><label for="f-from">Адрес подачи</label><input id="f-from" type="text" placeholder="Адрес, аэропорт или FBO" /></div>
<div class="field full"><label for="f-to">Пункт назначения</label><input id="f-to" type="text" placeholder="Адрес, аэропорт или FBO" /></div>
<div class="field"><label for="f-pax">Пассажиры</label><input id="f-pax" type="number" min="1" placeholder="2" /></div>
<div class="field"><label for="f-luggage">Багаж</label><input id="f-luggage" type="number" min="0" placeholder="2" /></div>
<div class="field"><label for="f-flight">Номер рейса</label><input id="f-flight" type="text" placeholder="Если применимо" /></div>
<div class="field"><label for="f-for">Поездка для</label>
<select id="f-for"><option>Меня</option><option>Другого пассажира</option></select>
</div>
<div class="field"><label for="f-seat">Детское кресло / бустер</label>
<select id="f-seat"><option>Не нужно</option><option>Кресло для младенца</option><option>Кресло-трансформер</option><option>Бустер</option></select>
</div>
<div class="field"><label for="f-contact-pref">Предпочтительный способ ответа</label>
<select id="f-contact-pref"><option>Звонок</option><option>WhatsApp</option><option>Эл. почта</option></select>
</div>
<div class="field full"><label for="f-svc">Услуга</label>
<select id="f-svc"><option>Трансфер из аэропорта</option><option>Частная авиация / FBO</option><option>Корпоративная</option><option>Почасовая / по маршруту клиента</option><option>Школа / семья</option><option>Мероприятие</option><option>Дальняя поездка</option></select>
</div>
<div class="field full"><label for="f-notes">Дополнительная информация</label><input id="f-notes" type="text" placeholder="Всё, что нам стоит знать" /></div>
</div>
<div class="form-actions">
<button class="btn btn-light" id="sendBtn" type="button">Отправить через WhatsApp</button>
<a class="btn btn-ghost" href="tel:+17869316699">Или позвоните</a>
</div>
<p class="form-note">Откроется WhatsApp с уже заполненными данными. Ничего не отправляется, пока вы сами не нажмёте «отправить». Каждый запрос рассматривается и подтверждается индивидуально, прежде чем назначается автомобиль.</p>
<p class="form-note" style="margin-top:8px;opacity:.7">Отправляя эту форму, вы передаёте свои данные Onyx Executive Miami через WhatsApp или электронную почту; они используются только для организации и подтверждения вашей поездки. Информация не продаётся и не передаётся третьим лицам.</p>
</div>
</div>
</section>
<SiteFooter lang="ru" current="contact.html" />
<div class="mbar"><a href="tel:+17869316699">Позвонить</a><a href="https://wa.me/17869316699?text=%D0%97%D0%B4%D1%80%D0%B0%D0%B2%D1%81%D1%82%D0%B2%D1%83%D0%B9%D1%82%D0%B5%2C%20%D1%85%D0%BE%D1%82%D0%B5%D0%BB%20%D0%B1%D1%8B%20%D0%B7%D0%B0%D0%BA%D0%B0%D0%B7%D0%B0%D1%82%D1%8C%20%D1%88%D0%BE%D1%84%D1%91%D1%80%D0%B0%20%D0%B2%20%D0%AE%D0%B6%D0%BD%D0%BE%D0%B9%20%D0%A4%D0%BB%D0%BE%D1%80%D0%B8%D0%B4%D0%B5." target="_blank" rel="noopener">WhatsApp</a></div>
<script is:inline>
document.getElementById('yr').textContent=new Date().getFullYear();
var b=document.getElementById('sendBtn');
if(b){b.addEventListener('click',function(){
var v=function(id){var e=document.getElementById(id);return e?(e.value||'').trim():'';};
var t=['Новая заявка на шофёра — Onyx Executive Miami','','Имя: '+(v('f-name')||'—'),'Телефон: '+(v('f-phone')||'—'),'Эл. почта: '+(v('f-email')||'—'),'Услуга: '+v('f-svc'),'Дата/время: '+(v('f-date')||'—'),'Пассажиры: '+(v('f-pax')||'—'),'Багаж: '+(v('f-luggage')||'—'),'Рейс №: '+(v('f-flight')||'—'),'Поездка для: '+v('f-for'),'Детское кресло: '+v('f-seat'),'Подача: '+(v('f-from')||'—'),'Высадка: '+(v('f-to')||'—'),'Способ ответа: '+v('f-contact-pref'),'Примечания: '+(v('f-notes')||'—')];
if(typeof gtag==='function'){gtag('event','generate_lead',{event_category:'contact',event_label:'contact_full_form',service:v('f-svc')});}
window.open('https://wa.me/17869316699?text='+encodeURIComponent(t.join('\n')),'_blank');
});}
var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});},{threshold:.12});
document.querySelectorAll('.reveal').forEach(function(el){io.observe(el);});
</script>
<SiteScripts />
</Base>
