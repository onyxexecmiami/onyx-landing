---
import Base from '../../layouts/Base.astro';
import Fonts from '../../components/Fonts.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import YearReveal from '../../components/YearReveal.astro';
import SiteScripts from '../../components/SiteScripts.astro';
---
<Base lang="ru" page="fleet.html">
<Fragment slot="head">
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Наш автомобиль — Chevrolet Suburban RST 2026 | Onyx Executive Miami</title>
<meta name="description" content="Один безупречно ухоженный Chevrolet Suburban RST 2026 года — автомобиль, на котором проходит каждая поездка Onyx Executive Miami. Места, удобства и что вас ждёт на борту." />
<meta name="theme-color" content="#0A0A0A" />
<Fonts />
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Vehicle",
  "name": "Chevrolet Suburban RST 2026",
  "vehicleModelDate": "2026",
  "manufacturer": {
    "@type": "Organization",
    "name": "Chevrolet"
  },
  "model": "Suburban RST",
  "image": "https://onyxexecmiami.com/suburban-front.webp",
  "offers": {
    "@type": "Offer",
    "offeredBy": {
      "@id": "https://onyxexecmiami.com/#business"
    }
  }
}
</script>
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Главная",
      "item": "https://onyxexecmiami.com/ru/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Наш автомобиль"
    }
  ]
}
</script>
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Почему у вас один автомобиль, а не большой автопарк?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Один автомобиль, который содержится по единому стандарту, — это возможность заранее знать, что именно за вами приедет. По мере того как Onyx вырастет в небольшую сеть, каждый новый автомобиль будет соответствовать тому же стандарту, а не браться из арендного пула."
      }
    },
    {
      "@type": "Question",
      "name": "Очищается ли автомобиль после каждой поездки?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Да. Салон и кузов проверяются и приводятся в порядок между поездками, а не по фиксированному графику, при котором автомобиль мог бы выглядеть прилично, но не безупречно перед следующим заказом в тот же день."
      }
    },
    {
      "@type": "Question",
      "name": "Поместятся ли в Suburban клюшки для гольфа, коляски или негабаритный багаж?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Как правило, да — вместимость зависит от числа пассажиров, а также от количества и размера багажа. Сообщите при бронировании, что вы везёте, и мы подтвердим, что всё поместится, до вашего приезда, а не после."
      }
    },
    {
      "@type": "Question",
      "name": "Что будет, если автомобилю потребуется внеплановое обслуживание?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Обслуживание планируется вокруг бронирований, а не наоборот, а сеть проверенных партнёрских автомобилей закрывает редкий случай внепланового сбоя, так что бронирование не отменяется просто так."
      }
    },
    {
      "@type": "Question",
      "name": "Детские кресла входят в стоимость или нужно брать свои?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Детские кресла подготавливаются заранее, когда вы сообщаете возраст детей при бронировании, — брать свои не нужно, если только вы сами этого не предпочитаете."
      }
    }
  ]
}
</script>
</Fragment>
<SiteHeader lang="ru" page="fleet.html" current="fleet.html" />
<main id="main">

<section class="page-hero">
<div class="wrap">
<p class="breadcrumb"><a href="/ru/">Главная</a> / Наш автомобиль</p>
<p class="eyebrow on-dark">Автомобиль</p>
<h1 class="display">Один автомобиль. Безупречный уход.</h1>
<div class="rule"></div>
<p class="lead">Chevrolet Suburban RST 2026 года — тот самый автомобиль, на котором проходит каждая поездка Onyx; он содержится по единому стандарту, а не берётся из арендного пула.</p>
<div class="page-actions">
<a class="btn btn-light" href="tel:+17869316699">Позвонить</a>
<a class="btn btn-ghost" href="contact.html#book">Запросить расчёт</a>
</div>
<p class="trust-line">+1 786 931 ONYX (6699) · Лицензия и страхование · Miami-Dade Permit #64666 · D-U-N-S&reg; 13-860-0693</p>
</div>
</section>
<section class="section-soft" style="padding-top:0">
<div class="wrap"><div class="feat-img reveal" style="aspect-ratio:16/9"><picture><source type="image/avif" srcset="/suburban-front.avif" /><img src="/suburban-front.webp" alt="Чёрный Chevrolet Suburban RST 2026, вид спереди в три четверти, у курорта в Южной Флориде" width="1100" height="1467" decoding="async" fetchpriority="high" /></picture></div></div>
</section>
<section class="section-soft">
<div class="wrap">
<div class="grid-head reveal" style="text-align:center;margin-bottom:28px">
<p class="eyebrow">Стандарты автомобиля</p>
<h2 class="h2">Каждая поездка — один стандарт</h2>
<div class="rule"></div>
<p class="lead">Единый стандарт. Проверка перед каждой поездкой.</p>
</div>
<div class="cards reveal" style="text-align:center">
<div class="card" style="cursor:default"><h3>Проверка перед поездкой</h3><p>Осмотр перед каждой поездкой — салон, кузов, технические жидкости, шины. Без исключений.</p></div>
<div class="card" style="cursor:default"><h3>Бесплатные удобства</h3><p>Охлаждённая бутилированная вода и зарядки для телефона у каждого места. Климат-контроль настроен до того, как вы сядете.</p></div>
<div class="card" style="cursor:default"><h3>Полная страховка</h3><p>Коммерческая страховка, лицензированный шофёр и полное соответствие требованиям Miami-Dade.</p></div>
</div>
</div>
</section>
<section class="section-soft">
<div class="wrap split">
<div class="prose reveal">
<h2 class="h2">Простор без компромиссов</h2>
<div class="rule"></div>
<p>Места для шести пассажиров. Вместимость багажа зависит от числа пассажиров, размеров чемоданов, детских кресел, колясок, сумок для гольфа и от того, нужны ли все ряды сидений. Вместимость подтверждается до бронирования.</p>
<div class="feat-img reveal" style="aspect-ratio:4/3;margin-top:24px"><picture><source type="image/avif" srcset="/interior-seats.avif" /><img src="/interior-seats.webp" alt="Салон Chevrolet Suburban RST компании Onyx Executive Miami, пассажирские сиденья" width="700" height="933" decoding="async" loading="lazy" /></picture></div>
</div>
<div class="prose reveal">
<h2 class="h2">На борту</h2>
<div class="rule"></div>
<ul class="points">
<li><i class="mark"></i><span><b>Климат-контроль</b> спереди и сзади, настроенный до вашей посадки.</span></li>
<li><i class="mark"></i><span><b>Бутилированная вода</b> и зарядки для телефона у каждого места.</span></li>
<li><i class="mark"></i><span><b>Тихий салон</b> — без радио и разговоров, если вы сами их не захотите.</span></li>
<li><i class="mark"></i><span><b>Детские кресла</b> подготавливаются заранее, когда вы сообщаете возраст детей при бронировании.</span></li>
</ul>
<div class="feat-img reveal" style="aspect-ratio:4/3;margin-top:24px"><picture><source type="image/avif" srcset="/interior-amenities.avif" /><img src="/interior-amenities.webp" alt="Удобства в салоне Chevrolet Suburban RST компании Onyx Executive Miami" width="700" height="933" decoding="async" loading="lazy" /></picture></div>
</div>
</div>
</section>
<section class="section-dark">
<div class="wrap split center">
<div class="prose reveal">
<p class="eyebrow on-dark">Почему один автомобиль</p>
<h2 class="h2">Постоянство важнее автопарка.</h2>
<div class="rule"></div>
<p>Один хорошо ухоженный автомобиль — это никаких сюрпризов: вы заранее знаете, что именно за вами приедет. В этом и смысл Стандарта Onyx: ответственность основателя не только за водителя, но и за автомобиль.</p>
<div style="margin-top:28px"><a class="btn btn-outline" href="the-onyx-standard.html">Читать о Стандарте Onyx</a></div>
</div>
<div class="feat-img reveal"><picture><source type="image/avif" srcset="/suburban-side.avif" /><img src="/suburban-side.webp" alt="Chevrolet Suburban RST компании Onyx Executive Miami, вид сбоку" width="1100" height="825" decoding="async" loading="lazy" /></picture></div>
</div>
</section>
<section class="section-dark">
<div class="wrap">
<div class="grid-head reveal">
<h2 class="h2">Вопросы об автомобиле</h2>
<div class="rule"></div>
</div>
<div class="faq reveal">
<details><summary>Почему у вас один автомобиль, а не большой автопарк?<span class="pm">+</span></summary><div class="ans">Один автомобиль, который содержится по единому стандарту, — это возможность заранее знать, что именно за вами приедет. По мере того как Onyx вырастет в небольшую сеть, каждый новый автомобиль будет соответствовать тому же стандарту, а не браться из арендного пула.</div></details>
