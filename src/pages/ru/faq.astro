---
import Base from '../../layouts/Base.astro';
import Fonts from '../../components/Fonts.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import YearReveal from '../../components/YearReveal.astro';
import SiteScripts from '../../components/SiteScripts.astro';
---
<Base lang="ru" page="faq.html">
<Fragment slot="head">
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Вопросы и ответы — Onyx Executive Miami | Частный шофёр в Южной Флориде</title>
<meta name="description" content="Ответы об Onyx Executive Miami: зона обслуживания, бронирование, оплата, детские кресла, языки и корпоративные счета для услуг частного шофёра в Южной Флориде." />
<meta name="theme-color" content="#0A0A0A" />
<Fonts />
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Какие районы вы обслуживаете?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Майами-Дейд, Бровард и Палм-Бич, включая Авентуру, Санни-Айлс, Бал-Харбор, Бриквелл, Майами-Бич и Форт-Лодердейл. Дальние поездки во Флорида-Кис, Нейплс и Орландо — по запросу."
      }
    },
    {
      "@type": "Question",
      "name": "Как забронировать поездку?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Позвоните или напишите в WhatsApp, чтобы получить ответ быстрее всего, либо воспользуйтесь формой запроса на странице контактов. От расчёта до высадки вы общаетесь с одним контактным лицом."
      }
    },
    {
      "@type": "Question",
      "name": "Как устроены цены и оплата?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Стоимость поездки называется как фиксированная цена и подтверждается до поездки; дорожные сборы и стандартное время ожидания включены. Мы принимаем карты (через терминал), Zelle и оплату по счёту для корпоративных клиентов."
      }
    },
    {
      "@type": "Question",
      "name": "Вы отслеживаете рейсы?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Да. При встрече в аэропорту или в терминале частной авиации (FBO) мы отслеживаем ваш прилёт, и время подачи подстраивается под фактическую посадку, включая задержки и долгий таможенный контроль."
      }
    },
    {
      "@type": "Question",
      "name": "Можно ли поехать с детьми и детскими креслами?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Да. При бронировании сообщите количество и возраст детей, чтобы нужные кресла были подготовлены заранее."
      }
    },
    {
      "@type": "Question",
      "name": "На каких языках вы говорите?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "На английском, русском, украинском и польском."
      }
    },
    {
      "@type": "Question",
      "name": "Вы предоставляете страховой сертификат?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Страховой сертификат (COI) предоставляется по запросу — он часто нужен корпоративным офисам и площадкам, прежде чем бронирование будет подтверждено."
      }
    },
    {
      "@type": "Question",
      "name": "За какое время нужно бронировать?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Как можно раньше — для трансферов из аэропорта, в FBO и на мероприятия, особенно в загруженные выходные. Часто возможно и более короткое уведомление: позвоните, и мы сразу скажем, как обстоят дела."
      }
    }
  ],
  "publisher": {
    "@id": "https://onyxexecmiami.com/#business"
  }
}
</script>
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Главная",
      "item": "https://onyxexecmiami.com/ru/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Вопросы и ответы"
    }
  ]
}
</script>
</Fragment>
