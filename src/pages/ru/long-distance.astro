  "mainEntity": [
    {
      "@type": "Question",
      "name": "Делится ли автомобиль с другими пассажирами?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Нет — автомобиль принадлежит только вам на время поездки, одна компания за раз, а не общий шаттл."
