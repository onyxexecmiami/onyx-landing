---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import YearReveal from '../components/YearReveal.astro';
import SiteScripts from '../components/SiteScripts.astro';
---
<Base lang="en">
<Fragment slot="head">
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Executive Chauffeur Service Miami — Hourly &amp; As-Directed | Onyx Executive Miami</title>
<meta name="description" content="Hourly and as-directed executive chauffeur service in Miami and South Florida. Meetings, roadshows, multi-stop days, and evenings — one chauffeur, your schedule." />
<link rel="canonical" href="https://onyxexecmiami.com/executive-chauffeur.html" />
<meta name="theme-color" content="#0A0A0A" />
<Fonts />
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Executive chauffeur service",
  "provider": {
    "@id": "https://onyxexecmiami.com/#business",
    "name": "Onyx Executive Miami",
    "url": "https://onyxexecmiami.com/"
  },
  "areaServed": {
    "@type": "State",
    "name": "South Florida"
  },
  "url": "https://onyxexecmiami.com/executive-chauffeur.html"
}
</script>
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://onyxexecmiami.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Executive Chauffeur"
    }
  ]
}
</script>
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {"@type": "Question","name": "Is there a minimum booking length?","acceptedAnswer": {"@type": "Answer","text": "Yes — minimum hours are confirmed with your quote, based on your date and itinerary. There's no single published number because it varies by day and demand."}},
    {"@type": "Question","name": "What if I need extra time beyond what I booked?","acceptedAnswer": {"@type": "Answer","text": "Additional time is billed by the hour at the same rate, subject to the chauffeur's availability for the rest of the day — confirm in advance if there's a chance you'll run long."}},
    {"@type": "Question","name": "Can I add stops that weren't in the original plan?","acceptedAnswer": {"@type": "Answer","text": "Yes, within the hours you've booked. Extra stops don't require a new booking — just tell your chauffeur."}},
    {"@type": "Question","name": "What does \"as-directed\" mean?","acceptedAnswer": {"@type": "Answer","text": "The chauffeur follows your instructions in real time rather than a fixed route — wait here, go there next, change plans mid-afternoon. You're not locked into an itinerary set at booking."}},
    {"@type": "Question","name": "Are parking and tolls included?","acceptedAnswer": {"@type": "Answer","text": "Tolls are included in the quoted rate. Parking or valet fees at a specific venue, if any, are confirmed case by case."}},
    {"@type": "Question","name": "What happens during standby or a meal break?","acceptedAnswer": {"@type": "Answer","text": "Standby time — waiting while you're in a meeting or at dinner — is part of the hours you've booked. Your chauffeur takes a meal break during long standby periods without leaving you without coverage; this is coordinated so it never falls during an active pickup."}},
    {"@type": "Question","name": "Is there room for luggage or shopping bags between stops?","acceptedAnswer": {"@type": "Answer","text": "Yes — capacity is confirmed at booking based on what you're bringing, common for shopping trips or a day that starts or ends at the airport."}},
    {"@type": "Question","name": "Can I extend on the day, once we're already out?","acceptedAnswer": {"@type": "Answer","text": "Usually, yes, but it's subject to availability — if the chauffeur has another booking after yours, an extension may not be possible. Flagging a likely extension in advance avoids that."}}
  ]
}
</script>
</Fragment>
<SiteHeader />

<section class="page-hero">
<div class="wrap">
<p class="breadcrumb"><a href="/">Home</a> / Executive Chauffeur</p>
<p class="eyebrow on-dark">Executive Chauffeur · Hourly &amp; As-Directed</p>
<h1 class="display">A chauffeur for the whole day, not just the trip.</h1>
<div class="rule"></div>
<p class="lead">Hourly and as-directed service for meetings, roadshows, multi-stop afternoons, and evenings out. Your chauffeur stays with you, holds the schedule, and adjusts as the day moves.</p>
<div class="page-actions">
<a class="btn btn-light" href="tel:+17869316699">Call now</a>
<a class="btn btn-light" href="https://wa.me/17869316699?text=Hi%2C%20I%27d%20like%20hourly%20chauffeur%20service." target="_blank" rel="noopener">WhatsApp</a>
<a class="btn btn-ghost" href="contact.html#book">Request a quote</a>
</div>
<p class="trust-line">+1 786 931 ONYX (6699) · Licensed &amp; insured · Miami-Dade Permit #64666 · D-U-N-S&reg; 13-860-0693</p>
</div>
</section>
<section class="section-soft">
<div class="wrap split">
<div class="prose reveal">
<h2 class="h2">Booked by the hour, run on your clock.</h2>
<div class="rule"></div>
<p>For days with more than one stop — client meetings, property tours, a roadshow across Brickell and downtown, an evening that runs late — the same chauffeur stays on. No re-booking between legs, no waiting on a new car, no explaining the plan twice.</p>
<p>Tell us the start time and rough itinerary; we hold the vehicle and adjust as plans shift through the day. Common uses: meetings, roadshows, client dinners, shopping, and medical appointments where a wait-and-return beats booking two separate rides.</p>
</div>
<div class="feat-img reveal"><picture><source type="image/avif" srcset="interior-amenities.avif" /><img src="interior-amenities.webp" alt="Onyx Executive Miami Suburban cabin with complimentary bottled water" width="700" height="933" decoding="async" fetchpriority="high" /></picture></div>
</div>
</section>
<section class="section-dark">
<div class="wrap">
<div class="grid-head reveal" style="margin-bottom:28px">
<p class="eyebrow on-dark">How Hourly Works</p>
<h2 class="h2">The details, before you book.</h2>
<div class="rule"></div>
</div>
<div class="faq reveal">
<details><summary>Is there a minimum booking length?<span class="pm">+</span></summary><div class="ans">Yes — minimum hours are confirmed with your quote, based on your date and itinerary. There's no single published number because it varies by day and demand.</div></details>
<details><summary>What if I need extra time beyond what I booked?<span class="pm">+</span></summary><div class="ans">Additional time is billed by the hour at the same rate, subject to the chauffeur's availability for the rest of the day — confirm in advance if there's a chance you'll run long.</div></details>
<details><summary>Can I add stops that weren't in the original plan?<span class="pm">+</span></summary><div class="ans">Yes, within the hours you've booked. Extra stops don't require a new booking — just tell your chauffeur.</div></details>
<details><summary>What does "as-directed" mean?<span class="pm">+</span></summary><div class="ans">The chauffeur follows your instructions in real time rather than a fixed route — wait here, go there next, change plans mid-afternoon. You're not locked into an itinerary set at booking.</div></details>
<details><summary>Are parking and tolls included?<span class="pm">+</span></summary><div class="ans">Tolls are included in the quoted rate. Parking or valet fees at a specific venue, if any, are confirmed case by case.</div></details>
<details><summary>What happens during standby or a meal break?<span class="pm">+</span></summary><div class="ans">Standby time — waiting while you're in a meeting or at dinner — is part of the hours you've booked. Your chauffeur takes a meal break during long standby periods without leaving you without coverage; this is coordinated so it never falls during an active pickup.</div></details>
<details><summary>Is there room for luggage or shopping bags between stops?<span class="pm">+</span></summary><div class="ans">Yes — capacity is confirmed at booking based on what you're bringing, common for shopping trips or a day that starts or ends at the airport.</div></details>
<details><summary>Can I extend on the day, once we're already out?<span class="pm">+</span></summary><div class="ans">Usually, yes, but it's subject to availability — if the chauffeur has another booking after yours, an extension may not be possible. Flagging a likely extension in advance avoids that.</div></details>
</div>
</div>
</section>
<section class="section-soft" style="padding-top:0">
<div class="wrap">
<p class="eyebrow">Related</p>
<h2 class="h2" style="margin-bottom:30px">Often booked with</h2>
<div class="related reveal">
<a href="corporate.html"><div class="rk">Accounts</div><h3>Corporate transportation</h3></a>
<a href="event-transportation.html"><div class="rk">Events</div><h3>Event transportation</h3></a>
<a href="airport-transfers.html"><div class="rk">Airports</div><h3>Airport transfers</h3></a>
</div>
</div>
</section>
<section class="cta-band"><div class="wrap">
<h2 class="h2">Plan a day.</h2>
<p>Share your start time and stops — we'll quote the hours and have one chauffeur for all of it.</p>
<div class="actions"><a class="btn btn-light" href="tel:+17869316699">Call +1 786 931 ONYX (6699)</a><a class="btn btn-ghost" href="contact.html#book">Request a quote</a></div>
</div></section>
<SiteFooter />
<div class="mbar"><a href="tel:+17869316699">Call</a><a href="https://wa.me/17869316699?text=Hi%2C%20I%27d%20like%20hourly%20chauffeur%20service." target="_blank" rel="noopener">WhatsApp</a></div>
<YearReveal />
<SiteScripts />
</Base>
