import SiteFooter from '../components/SiteFooter.astro';
import YearReveal from '../components/YearReveal.astro';
import SiteScripts from '../components/SiteScripts.astro';
---
<Base lang="en">
<Fragment slot="head">
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Cruise Port Transportation | PortMiami &amp; Port Everglades | Onyx Executive Miami</title>
<meta name="description" content="Private chauffeur service to PortMiami and Port Everglades. Terminal-aware drop-off, luggage handling, and fixed quotes for cruise embarkation and disembarkation." />
<link rel="canonical" href="https://onyxexecmiami.com/cruise-transportation.html" />
<meta name="theme-color" content="#0A0A0A" />
<Fonts />
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Cruise port ground transportation service",
  "provider": {
    "@id": "https://onyxexecmiami.com/#business",
    "name": "Onyx Executive Miami",
    "url": "https://onyxexecmiami.com/"
  },
  "areaServed": {
    "@type": "State",
    "name": "South Florida"
