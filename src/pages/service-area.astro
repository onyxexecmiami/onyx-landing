---
<Base lang="en" page="service-area.html">
<Fragment slot="head">
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Service Area — South Florida Chauffeur | Onyx Executive Miami</title>
<meta name="description" content="Onyx Executive Miami serves Aventura, Sunny Isles, Bal Harbour, Brickell, Miami Beach, Fort Lauderdale, and Palm Beach with private chauffeur and black-SUV service." />
<meta name="theme-color" content="#0A0A0A" />
<Fonts />
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "url": "https://onyxexecmiami.com/service-area.html",
  "about": {
    "@id": "https://onyxexecmiami.com/#business"
  }
}
