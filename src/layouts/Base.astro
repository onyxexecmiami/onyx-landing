---
import Analytics from '../components/Analytics.astro';
import { LANGS, pageUrl, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  // This page's file name ("faq.html", "index.html"). With it the layout writes canonical and
  // hreflang links for all three languages; without it (404) it writes none.
  page?: string;
}
const { lang, page } = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
<Analytics />
<link rel="icon" href="/favicon.svg?v=5" type="image/svg+xml" />
<link rel="icon" href="/favicon-32.png?v=5" type="image/png" sizes="32x32" />
<link rel="icon" href="/favicon.ico?v=5" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=5" />
<slot name="head" />
{page && <link rel="canonical" href={pageUrl(lang, page)} />}
{page && LANGS.map((l) => <link rel="alternate" hreflang={l} href={pageUrl(l, page)} />)}
{page && <link rel="alternate" hreflang="x-default" href={pageUrl('en', page)} />}
</head>
<body>
<slot />
</body>
</html>
