---
// Full-bleed Suburban over the Miami skyline, 404 message and section tiles, in the page's language.
// Served by worker/index.js for any missing URL (per language prefix), so every link is root-relative.
import Base from '../layouts/Base.astro';
import Fonts from './Fonts.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import YearReveal from './YearReveal.astro';
import SiteScripts from './SiteScripts.astro';
import { ui, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const nf = t.nf;
const root = lang === 'en' ? '/' : `/${lang}/`;
const wa = 'https://wa.me/17869316699?text=' + encodeURIComponent(t.waQuote);
---
<Base lang={lang}>
<Fragment slot="head">
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{nf.title}</title>
<meta name="robots" content="noindex" />
<meta name="theme-color" content="#0A0A0A" />
<Fonts />
</Fragment>
<SiteHeader lang={lang} />
<main class="nf">
  <picture class="nf-media">
    <source type="image/avif" srcset="/404-suburban-800.avif 800w, /404-suburban-1448.avif 1448w" sizes="100vw" />
    <img src="/404-suburban-1448.webp" srcset="/404-suburban-800.webp 800w, /404-suburban-1448.webp 1448w" sizes="100vw"
      alt={nf.alt} width="1448" height="1086" fetchpriority="high" />
  </picture>
  <div class="nf-shade" aria-hidden="true"></div>

  <div class="wrap nf-inner">
    <p class="eyebrow on-dark nf-step" style="--i:0">{nf.eyebrow}</p>
    <p class="nf-code nf-step" style="--i:1" aria-hidden="true">404</p>
    <h1 class="display nf-title nf-step" style="--i:2">{nf.h1a}<br />{nf.h1b}</h1>
    <div class="rule nf-step" style="--i:3"></div>
    <p class="lead nf-lead nf-step" style="--i:3">{nf.lead}</p>
    <div class="nf-actions nf-step" style="--i:4">
      <a class="btn btn-light" href={root}>{nf.home}</a>
      <a class="btn btn-ghost" href="tel:+17869316699">{nf.call}</a>
      <a class="btn btn-ghost" href={wa} target="_blank" rel="noopener">WhatsApp</a>
    </div>

    <nav class="nf-menu nf-step" style="--i:5" aria-label={nf.menuLabel}>
      {nf.tiles.map(([href, label, note]) => (
        <a class="nf-tile" href={root + href}>
          <span class="nf-tile-label">{label}</span>
          <span class="nf-tile-note">{note}</span>
          <span class="nf-tile-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </nav>
  </div>
</main>
<SiteFooter lang={lang} />
<div class="mbar"><a href="tel:+17869316699">{t.call}</a><a href={wa} target="_blank" rel="noopener">WhatsApp</a></div>
<YearReveal />
<SiteScripts />
</Base>

<style>
  .nf {
    position: relative;
    min-height: calc(100svh - 96px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--onyx);
    color: #fff;
  }
  .nf-media { display: block; position: absolute; inset: 0; overflow: hidden; }
  .nf-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 60%;
    animation: nf-drift 18s ease-out both;
  }
  .nf-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(10, 10, 10, .94) 0%, rgba(10, 10, 10, .82) 40%, rgba(10, 10, 10, .2) 66%, rgba(10, 10, 10, 0) 100%),
      linear-gradient(180deg, rgba(10, 10, 10, .25) 0%, rgba(10, 10, 10, 0) 25%, rgba(10, 10, 10, 0) 60%, rgba(10, 10, 10, .9) 100%);
  }
  .nf-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-block: clamp(40px, 7vh, 88px);
  }
  .nf-code {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(96px, 13vw, 180px);
    line-height: .82;
    letter-spacing: -.02em;
    color: transparent;
    -webkit-text-stroke: 1px var(--gold);
    background: linear-gradient(100deg, rgba(212, 175, 55, 0) 30%, rgba(212, 175, 55, .55) 50%, rgba(212, 175, 55, 0) 70%) no-repeat;
    background-size: 250% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    animation: nf-shine 5.5s ease-in-out 1.2s infinite;
    margin-block-end: 18px;
    user-select: none;
  }
  .nf-title { max-width: 18ch; font-size: clamp(34px, 4.2vw, 54px); }
  .nf-lead { max-width: 46ch; }
  .nf-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-block-start: 34px; }

  .nf-menu {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin-block-start: clamp(40px, 7vh, 72px);
    max-width: 980px;
    background: var(--hair-dark);
    border: 1px solid var(--hair-dark);
  }
  .nf-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px 22px 22px;
    background: rgba(10, 10, 10, .72);
    backdrop-filter: blur(6px);
    transition: background-color .3s ease;
  }
  .nf-tile::after {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block-end: 0;
    width: 100%;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .35s ease;
  }
  .nf-tile:hover, .nf-tile:focus-visible { background: rgba(22, 22, 21, .92); }
  .nf-tile:hover::after, .nf-tile:focus-visible::after { transform: scaleX(1); }
  .nf-tile-label { font-family: var(--display); font-size: 21px; line-height: 1.15; color: #fff; }
  .nf-tile-note { font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted-light); }
  .nf-tile-arrow {
    position: absolute;
    inset-inline-end: 18px;
    inset-block-start: 18px;
    color: var(--gold);
    opacity: .5;
    transition: transform .3s ease, opacity .3s ease;
  }
  .nf-tile:hover .nf-tile-arrow, .nf-tile:focus-visible .nf-tile-arrow { opacity: 1; transform: translateX(4px); }

  .nf-step { animation: nf-rise .9s cubic-bezier(.2, .7, .2, 1) both; animation-delay: calc(var(--i) * 110ms + 150ms); }
  .nf-code.nf-step { animation: nf-rise .9s cubic-bezier(.2, .7, .2, 1) calc(var(--i) * 110ms + 150ms) both, nf-shine 5.5s ease-in-out 1.6s infinite; }

  @keyframes nf-rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @keyframes nf-drift { from { transform: scale(1.1); } to { transform: scale(1); } }
  @keyframes nf-shine { 0% { background-position: 120% 0; } 60%, 100% { background-position: -120% 0; } }

  @media (max-width: 900px) {
    .nf { display: block; min-height: 0; }
    .nf-media { position: relative; height: 46svh; min-height: 280px; }
    .nf-media img { object-position: 45% 60%; }
    .nf-shade { display: none; }
    .nf-media::after { content: ""; position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(10, 10, 10, .1) 0%, rgba(10, 10, 10, 0) 50%, var(--onyx) 100%); }
    .nf-inner { margin-block-start: -96px; padding-block: 0 56px; }
    .nf-menu { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 420px) {
    .nf-tile { padding: 16px 16px 18px; }
    .nf-tile-label { font-size: 18px; }
    .nf-actions .btn { flex: 1 1 100%; justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nf-media img, .nf-step, .nf-code.nf-step { animation: none; }
  }
</style>
