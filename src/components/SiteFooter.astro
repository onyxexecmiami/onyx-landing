---
// Footer with company details, license and registration numbers, GRiDD badge, in the page's language.
import { prefix, ui, type Lang } from '../i18n/ui';
interface Props {
  lang?: Lang;
  current?: string;
}
const { lang = 'en', current } = Astro.props;
const t = ui[lang];
const p = prefix(lang);
const c = (href: string) => (href === current ? 'page' : undefined);
---
<footer class="site"><div class="wrap">
<div class="foot-top">
<div><div class="foot-brand"><b>ONYX</b> <span>·</span> Executive Miami</div><p class="foot-tag">{t.footTag}</p></div>
<div class="foot-cols">
<div><h4>{t.fServices}</h4><a href={p + 'airport-transfers.html'}>{t.fAirport}</a><a href={p + 'private-aviation.html'}>{t.fPrivateAviation}</a><a href={p + 'corporate.html'}>{t.fCorporate}</a><a href={p + 'executive-chauffeur.html'}>{t.fExecutive}</a><a href={p + 'school-transportation.html'}>{t.fSchool}</a><a href={p + 'event-transportation.html'}>{t.fEvent}</a><a href={p + 'long-distance.html'}>{t.fLong}</a></div>
<div><h4>{t.fCompany}</h4><a href={p + 'the-onyx-standard.html'}>{t.fStandard}</a><a href={p + 'fleet.html'}>{t.fVehicle}</a><a href={p + 'service-area.html'}>{t.fArea}</a><a href={p + 'blog.html'}>{t.fBlog}</a><a href={p + 'faq.html'}>{t.fFaq}</a>
<a href={p + 'contact.html'} aria-current={c('contact.html')}>{t.fContactLink}</a></div>
<div><h4>{t.fContact}</h4><a href="tel:+17869316699">+1 786 931 ONYX (6699)</a><a href="https://wa.me/17869316699" target="_blank" rel="noopener">WhatsApp</a><a href="https://instagram.com/onyxexecmiami" target="_blank" rel="noopener">@onyxexecmiami</a><a href="mailto:info@onyxexecmiami.com">info@onyxexecmiami.com</a></div>
</div>
</div>
<div class="foot-bottom"><span>© <span id="yr"></span> Onyx Executive Miami · Koretsky Logistics LLC</span><span>{t.region}</span><span set:html={t.licensed} /><span>Koretsky Logistics LLC L24000105653 · DBA Onyx Executive Miami G26000053223</span><span>D-U-N-S® 13-860-0693</span><a class="gridd-badge" href="https://griddtechnologies.com" target="_blank" rel="noopener" title={t.griddTitle}><img src="/gridd-badge.webp" alt={t.griddAlt} width="18" height="22" loading="lazy" decoding="async" /></a></div>
</div></footer>
