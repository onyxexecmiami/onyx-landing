---
// Brand fonts (Cormorant Garamond + Montserrat, self-hosted via the Astro fonts config), then the site stylesheet.
// No preload: each family is split by script (latin, cyrillic...) and Astro's preload data carries no subset,
// so preloading would fetch all eight files. Metric-matched fallbacks keep text from jumping while they load.
import { Font } from 'astro:assets';
---
<Font cssVariable="--font-display" />
<Font cssVariable="--font-body" />
<link rel="stylesheet" href="/style.css" />
