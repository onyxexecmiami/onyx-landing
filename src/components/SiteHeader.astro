---
// Top bar, main navigation with dropdowns, and the mobile menu, in the page's language.
// `current` marks the page in the main nav (gold underline); `mobileCurrent` marks it in the mobile menu.
// `page` is this page's file name, so the language switch leads to the same page in another language.
import { LANGS, SITE, pageUrl, prefix, ui, type Lang } from '../i18n/ui';
interface Props {
  lang?: Lang;
  page?: string;
  current?: string;
  mobileCurrent?: string;
}
const { lang = 'en', page = 'index.html', current, mobileCurrent } = Astro.props;
const t = ui[lang];
const p = prefix(lang);
const home = lang === 'en' ? '/' : `/${lang}/`;
const c = (href: string) => (href === current ? 'page' : undefined);
const m = (href: string) => (href === mobileCurrent ? 'page' : undefined);
---
<header>
<div class="util-bar"><div class="wrap">
<div class="util-left">
<a href="tel:+17869316699">+1 786 931 ONYX (6699)</a>
<span class="util-sep">·</span>
<a href="mailto:info@onyxexecmiami.com">info@onyxexecmiami.com</a>
<span class="util-sep">·</span>
<a href="https://wa.me/17869316699" target="_blank" rel="noopener">WhatsApp</a>
</div>
<div class="util-right">
<span>{t.region}</span>
<div class="util-lang">
{LANGS.map((l) => <a href={pageUrl(l, page).slice(SITE.length)} hreflang={l} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a>)}
</div>
</div>
</div></div>
<div class="wrap nav">
<a class="brand" href={home}><b>ONYX</b> <span>·</span> Executive Miami</a>
<nav class="nav-links"><div class="nav-drop"><a href={p + 'airport-transfers.html'} aria-current={c('airport-transfers.html')}>{t.airport}</a>
<div class="nav-drop-panel">
<span class="nav-drop-label">{t.commercialAirports}</span>
<a href={p + 'mia-airport.html'} aria-current={c('mia-airport.html')}>{t.mia}</a>
