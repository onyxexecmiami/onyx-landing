---
// Top bar, main navigation with dropdowns, and the mobile menu, in the page's language.
// `current` marks the page in the main nav (gold underline); `mobileCurrent` marks it in the mobile menu.
// `page` is this page's file name, so the language switch leads to the same page in another language.
import { LANGS, SITE, pageUrl, prefix, ui, type Lang } from '../i18n/ui';
interface Props {
  lang?: Lang;
  page?: string;
  current?: string;
  mobileCurrent?: string;
}
const { lang = 'en', page = 'index.html', current, mobileCurrent } = Astro.props;
const t = ui[lang];
const FLAG: Record<string, string> = { en: 'us', es: 'es', ru: 'ru' };
const LANG_NAME: Record<string, string> = { en: 'English', es: 'Español', ru: 'Русский' };
const p = prefix(lang);
const home = lang === 'en' ? '/' : `/${lang}/`;
const c = (href: string) => (href === current ? 'page' : undefined);
const m = (href: string) => (href === mobileCurrent ? 'page' : undefined);
