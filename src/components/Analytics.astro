---
// GA4 plus click events for phone, WhatsApp and email links. Same on every page.
---
<!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-0NQL5L01ZD"></script>
<script is:inline>
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', 'G-0NQL5L01ZD');
</script>
<script is:inline>
document.addEventListener('click', function(e){
  var a = e.target.closest('a');
  if(!a) return;
  var href = a.getAttribute('href') || '';
  if(href.indexOf('tel:') === 0){
    gtag('event','call_click',{event_category:'contact',event_label:href});
  } else if(href.indexOf('wa.me') !== -1){
    gtag('event','whatsapp_click',{event_category:'contact',event_label:href});
  } else if(href.indexOf('mailto:') === 0){
    gtag('event','email_click',{event_category:'contact',event_label:href});
  }
}, true);
</script>
